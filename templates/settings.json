{
  "extraKnownMarketplaces": {
    "agent-pipeline": {
      "source": { "source": "github", "repo": "RyanFilho/agent-pipeline" }
    }
  },
  "enabledPlugins": {
    "agent-pipeline@agent-pipeline": true
  },
  "advisorModel": "opus",
  "permissions": {
    "allow": [
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge * <MERGE_METHOD>)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh label list *)",
      "Bash(<BUILD_COMMAND_PREFIX> *)",
      "Bash(<TEST_COMMAND_PREFIX> *)",
      "Bash(git fetch *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-remote *)",
      "Bash(git switch -c * origin/<DEFAULT_BRANCH> --no-track)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge origin/<DEFAULT_BRANCH>)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin --delete feat/*)",
      "Bash(git push origin --delete fix/*)",
      "Bash(git push origin --delete chore/*)",
      "Bash(git push origin --delete docs/*)"
    ],
    "deny": [
      "Bash(git push origin <DEFAULT_BRANCH>*)",
      "Bash(git push origin HEAD:<DEFAULT_BRANCH>*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh pr merge * --admin*)"
    ]
  }
}
